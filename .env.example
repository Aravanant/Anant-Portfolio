# Supabase Configuration
# Replace these with your actual keys from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Admin Passcode for adding/deleting items across the deployed site (defaults to anant@2025)
VITE_ADMIN_PASSCODE=anant@2025
